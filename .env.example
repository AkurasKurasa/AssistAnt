# Copy this file to .env.local and fill in what you have.
# Everything is optional: with nothing set, AssistAnt runs on demo data and plain rules.

# ---------- Workspace ----------
# "demo" uses sample data. "notion" uses your real Notion workspace.
WORKSPACE=demo

# Notion internal integration (notion.so/my-integrations). Share the pages below with it.
NOTION_TOKEN=
NOTION_TASKS_PAGE_ID=
NOTION_REMINDERS_DB_ID=
NOTION_NOTES_PAGE_ID=

# Google Sheets (service account JSON, inline or a file path). Share the Stocks sheet with its email.
GOOGLE_SERVICE_ACCOUNT_JSON=
STOCKS_SHEET_ID=

# ---------- AI models ----------
# Your Claude Pro/Max plan, through Claude Code on this PC.
# Install Claude Code and run `claude login` once. No API key needed.
# Important: do NOT set ANTHROPIC_API_KEY globally, or Claude Code bills the API instead of your plan.
CLAUDE_CODE_ENABLED=true
CLAUDE_DAILY_BUDGET=25

# Free tiers
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# More free providers, from github.com/mnfst/awesome-free-llm-apis.
# Add any you sign up for; each one shows a "Get key" link in the Sources tab.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GONKA_API_KEY=
MODELSCOPE_API_KEY=
SILICONFLOW_API_KEY=
# These three work with no key at all (switch them on in Sources). A key raises their limits.
KILO_API_KEY=
LLM7_API_KEY=
OVH_AI_TOKEN=

# Local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Paid last resort (off by default in Sources)
CLAUDE_API_KEY=
CLAUDE_API_MODEL=claude-haiku-5-5

# ---------- Schedule ----------
# IANA time zone for dates and the schedule, e.g. Europe/Berlin. Defaults to UTC.
TIMEZONE=
# Currency the portfolio's crypto wallet is held in (converted to USD). Defaults to EUR.
WALLET_CURRENCY=
FINISH_DAY_TIME=22:10
MORNING_BRIEF_TIME=07:00
